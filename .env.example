# ---------------------------------------------------------------------------
# MarktAT – Umgebungsvariablen
# Kopieren:  cp .env.example .env
# Alle Werte unten sind reine ENTWICKLUNGSWERTE für die lokale Docker-Umgebung.
# Niemals echte Zugangsdaten committen. Produktion: Werte im Secret-Store hinterlegen.
# ---------------------------------------------------------------------------

# --- Allgemein ---------------------------------------------------------------
NODE_ENV=development
# Öffentliche URL des Frontends (Links in E-Mails, CORS, Redirects)
WEB_URL=http://localhost:3000
# URL der API, wie sie der Browser bzw. der Next.js-Server erreicht
API_URL=http://localhost:4000
API_PORT=4000

# --- Datenbank (PostgreSQL 16 + PostGIS) ----------------------------------------
POSTGRES_USER=marktat
POSTGRES_PASSWORD=marktat_dev_pw
POSTGRES_PORT=5433
DATABASE_URL=postgresql://marktat:marktat_dev_pw@localhost:5433/marktat
# Wird von den API-Integrationstests verwendet (Daten werden dort gelöscht!)
TEST_DATABASE_URL=postgresql://marktat:marktat_dev_pw@localhost:5433/marktat_test

# --- Supabase Auth ------------------------------------------------------------
# Lokal: GoTrue-Container hinter dem Gateway auf Port 54321.
# Produktion: Projekt-URL aus dem Supabase-Dashboard, z. B. https://xyz.supabase.co
SUPABASE_URL=http://localhost:54321
SUPABASE_PUBLIC_URL=http://localhost:54321
SUPABASE_GATEWAY_PORT=54321
# Öffentlicher Schlüssel für den Browser (Supabase: „anon“ bzw. „publishable key“).
# Lokaler Wert ist ein mit SUPABASE_JWT_SECRET signiertes Dev-Token.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1sb2NhbCIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzYxNTAwMDAwLCJleHAiOjIwNzY4NjAwMDB9.xIJyhOJ0NbXdrBbN7KgJoKzakb8TlZ26tfwSksWI_iw
# GEHEIM – nur serverseitig (API). Wird ab Phase 3 für Kontolöschung über die Admin-API genutzt.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1sb2NhbCIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE3NjE1MDAwMDAsImV4cCI6MjA3Njg2MDAwMH0.HfY92nDogT5bRPh3TaCy70esOhyYXUg4q0u5yUVoiBc
# GEHEIM – HS256-Secret zum Prüfen der Access-Tokens.
# Supabase-Projekte mit asymmetrischen Signaturschlüsseln: leer lassen, dann prüft die API per JWKS
# (SUPABASE_URL/auth/v1/.well-known/jwks.json).
SUPABASE_JWT_SECRET=marktat-local-dev-jwt-secret-change-me-0123456789

# --- E-Mail (lokal: Mailpit, UI unter http://localhost:8025) ------------------------
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="MarktAT <noreply@marktat.local>"
# true = TLS ab Verbindungsbeginn (Port 465); lokal mit Mailpit false
SMTP_SECURE=false
# Wartezeit, bevor eine E-Mail zu einer ungelesenen Nachricht rausgeht (wer vorher liest, bekommt keine)
MESSAGE_EMAIL_DELAY_SECONDS=120
# Wie oft gespeicherte Suchen mit Benachrichtigung auf neue Treffer geprüft werden
SAVED_SEARCH_ALERT_MINUTES=30

# --- Redis / BullMQ (ab Phase 2/3) ---------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Präfix der BullMQ-Warteschlangen und des Echtzeit-Kanals (Tests nutzen ein eigenes)
QUEUE_PREFIX=marktat
# false = diese Instanz nimmt nur Aufträge an, verarbeitet sie aber nicht (eigener Worker-Prozess)
JOBS_WORKER=true

# --- Meilisearch (Suche, ab Phase 4) -----------------------------------------------
# Ohne MEILI_URL sucht die API direkt in PostgreSQL (ohne Tippfehlertoleranz). Siehe docs/suche.md.
# Produktion: eigenen MEILI_MASTER_KEY (mind. 16 Zeichen) setzen, Meilisearch nicht öffentlich erreichbar machen.
MEILI_PORT=7700
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=marktat_dev_meili_master_key_change_me
# Name des Index (Tests verwenden listings_test)
MEILI_INDEX=listings

# --- Bilder: Cloudflare R2 (S3-kompatibel) -------------------------------------------
# Anleitung: docs/bilder.md. Der Bucket bleibt PRIVAT; der Browser bekommt nur kurzlebige signierte URLs.
# r2 = Cloudflare R2 (Standard). local = Dateisystem unter apps/api/.storage (nur Tests/Offline, nie Produktion).
STORAGE_DRIVER=r2
# FEHLT NOCH (lokal eintragen, niemals committen): Account-ID (32 Zeichen) und API-Token „Object Read & Write“
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=marktat-dev
# Jurisdiktion des Buckets: default | eu | fedramp. EU-Buckets sind nur über <account>.eu.r2.cloudflarestorage.com erreichbar.
R2_JURISDICTION=default
# Optional: Endpoint explizit setzen (überschreibt Account-ID + Jurisdiktion)
R2_ENDPOINT=
# Geheimnis für signierte Bild-URLs (Entwürfe) und den lokalen Speichertreiber. Produktion: Pflicht, mind. 32 Zeichen.
APP_SIGNING_SECRET=marktat-local-dev-signing-secret-change-me-0123456789
# Nur für STORAGE_DRIVER=local (Standard: apps/api/.storage)
LOCAL_STORAGE_DIR=

# --- Stripe (ab Phase 4, nur Testmodus-Schlüssel sk_test_/pk_test_) -----------------
# FEHLT NOCH: Testschlüssel aus dem Stripe-Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- OpenAI (optional, KI-Funktionen) ------------------------------------------------
# Leer lassen = KI-Funktionen deaktiviert. Die Plattform läuft ohne KI vollständig.
AI_ENABLED=false
OPENAI_API_KEY=

# --- Sicherheit -------------------------------------------------------------------
# Anfragen pro Minute und IP für die gesamte API (zusätzliche Limits je Endpunkt im Code)
RATE_LIMIT_PER_MINUTE=120
