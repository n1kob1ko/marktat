// MarktAT – Datenbankschema (PostgreSQL 16 + PostGIS)
// Überblick und geplante Erweiterungen: docs/datenmodell.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Die vier Hauptbereiche der Plattform
enum Vertical {
  MARKETPLACE
  VEHICLES
  REAL_ESTATE
  JOBS
}

enum AccountType {
  PRIVATE
  BUSINESS
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum PriceType {
  FIXED
  NEGOTIABLE
  FREE
  ON_REQUEST
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  EXPIRED
  REJECTED
  DELETED
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  ACCEPTABLE
  DEFECTIVE
}

// ---------------------------------------------------------------------------
// Benutzer
// ---------------------------------------------------------------------------

/// Profil zu einem Supabase-Auth-Benutzer. `id` entspricht `auth.users.id` (JWT-Claim `sub`).
/// Passwörter und Sitzungen verwaltet ausschließlich Supabase Auth.
model User {
  id                    String      @id @db.Uuid
  email                 String      @unique
  displayName           String      @map("display_name")
  accountType           AccountType @default(PRIVATE) @map("account_type")
  role                  UserRole    @default(USER)
  status                UserStatus  @default(ACTIVE)
  avatarUrl             String?     @map("avatar_url")
  bio                   String?
  phone                 String?
  /// Pflichtangaben gewerblicher Anbieter (Kennzeichnung nach DSA / ECG)
  companyName           String?     @map("company_name")
  companyRegisterNumber String?     @map("company_register_number")
  vatId                 String?     @map("vat_id")
  companyAddress        String?     @map("company_address")
  termsAcceptedAt       DateTime?   @map("terms_accepted_at")
  termsVersion          String?     @map("terms_version")
  lastSeenAt            DateTime?   @map("last_seen_at")
  /// E-Mail bei neuen Nachrichten (höchstens eine je Unterhaltung, bis wieder gelesen wurde)
  notifyMessagesByEmail Boolean     @default(true) @map("notify_messages_by_email")
  /// E-Mail bei neuen Treffern gespeicherter Suchen (nur Suchen mit aktivierter Benachrichtigung)
  notifySearchesByEmail Boolean     @default(true) @map("notify_searches_by_email")
  /// Zeitpunkt der aktuellen Sperre (Begründung in moderation_decisions)
  suspendedAt           DateTime?   @map("suspended_at")
  /// Meldungen dieser Person werden bis dahin nicht angenommen (Art. 23 DSA, nach Verwarnung)
  reportingBlockedUntil DateTime?   @map("reporting_blocked_until")
  /// Händlerprofil (Phase 7): Website, ob die Telefonnummer öffentlich ist, Logo (WebP, siehe docs/haendler.md)
  website               String?     @db.VarChar(200)
  showPhone             Boolean     @default(false) @map("show_phone")
  logoKey               String?     @map("logo_key")
  /// Deals (Phase 10): Bestätigung gewerblicher Anbieter nach Art. 30 DSA und Sperre durch das Team
  dealerCertifiedAt     DateTime?   @map("dealer_certified_at")
  dealsBlockedAt        DateTime?   @map("deals_blocked_at")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  deletedAt             DateTime?   @map("deleted_at")

  listings               Listing[]
  auditLogs              AuditLog[]
  favorites              Favorite[]
  dealFavorites          DealFavorite[]
  serviceFavorites       ServiceFavorite[]
  savedSearches          SavedSearch[]
  buyerConversations     Conversation[]         @relation("ConversationBuyer")
  sellerConversations    Conversation[]         @relation("ConversationSeller")
  sentMessages           Message[]              @relation("MessageSender")
  receivedMessages       Message[]              @relation("MessageRecipient")
  blocks                 UserBlock[]            @relation("BlockBy")
  blockedBy              UserBlock[]            @relation("BlockOf")
  reportsMade            Report[]               @relation("ReportBy")
  reportsReceived        Report[]               @relation("ReportOf")
  reportsAssigned        Report[]               @relation("ReportAssignee")
  reportsHandled         Report[]               @relation("ReportHandler")
  reportEvents           ReportEvent[]
  decisionsReceived      ModerationDecision[]   @relation("DecisionSubject")
  decisionsMade          ModerationDecision[]   @relation("DecisionModerator")
  appeals                Appeal[]               @relation("AppealBy")
  appealsReviewed        Appeal[]               @relation("AppealReviewer")
  notifications          Notification[]
  deletion               AccountDeletion?
  bookings               Booking[]
  payments               Payment[]
  deals                  Deal[]
  dealerStores           DealerStore[]
  dealImports            DealImport[]
  dealFeeds              DealFeed[]
  serviceProfile         ServiceProfile?
  reviewedQualifications ServiceQualification[] @relation("QualificationReviewer")
  serviceProjects        ServiceProject[]

  @@index([status])
  @@index([accountType, status])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Geografie: Bundesland -> Bezirk -> Ort (PLZ)
// ---------------------------------------------------------------------------

model State {
  /// 1 = Burgenland … 9 = Wien (Statistik-Austria-Kennziffer)
  id        Int        @id
  /// ISO 3166-2, z. B. "AT-9"
  code      String     @unique
  slug      String     @unique
  name      String
  districts District[]

  @@map("states")
}

/// Politischer Bezirk bzw. Statutarstadt; in Wien die 23 Gemeindebezirke.
model District {
  /// Bezirkskennziffer von Statistik Austria, z. B. 101 = Eisenstadt (Stadt), 901 = Wien 1., Innere Stadt
  id        Int        @id
  stateId   Int        @map("state_id")
  slug      String
  name      String
  state     State      @relation(fields: [stateId], references: [id])
  locations Location[]

  @@unique([stateId, slug])
  @@map("districts")
}

/// Ort mit Postleitzahl. Eine PLZ kann mehrere Orte umfassen und umgekehrt.
model Location {
  id              Int                                    @id @default(autoincrement())
  postalCode      String                                 @map("postal_code") @db.VarChar(4)
  place           String
  /// Gemeinde laut Statistik Austria (z. B. „Innsbruck“ für den Ortsteil „Wilten“), in Wien „Wien“
  municipality    String?
  slug            String
  districtId      Int                                    @map("district_id")
  latitude        Float
  longitude       Float
  /// Wird aus latitude/longitude befüllt (siehe Seed); für Umkreissuche mit ST_DWithin
  geom            Unsupported("geography(Point, 4326)")?
  district        District                               @relation(fields: [districtId], references: [id])
  listings        Listing[]
  dealerStores    DealerStore[]
  serviceProfiles ServiceProfile[]
  serviceProjects ServiceProject[]

  @@unique([postalCode, place])
  @@index([postalCode])
  @@index([districtId])
  @@index([geom], type: Gist)
  @@index([place(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Kategorien und Inserate
// ---------------------------------------------------------------------------

model Category {
  id              String     @id @default(cuid())
  parentId        String?    @map("parent_id")
  vertical        Vertical
  slug            String
  /// Eindeutiger Pfad für SEO-URLs, z. B. "marktplatz/elektronik/handys-smartphones"
  path            String     @unique
  name            String
  icon            String?
  sortOrder       Int        @default(0) @map("sort_order")
  isActive        Boolean    @default(true) @map("is_active")
  /// Definition kategorieabhängiger Felder (Typ, Label, Pflicht, Optionen) – ab Phase 2/5
  attributeSchema Json?      @map("attribute_schema")
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryTree")
  listings        Listing[]

  @@index([parentId])
  @@index([vertical, isActive])
  @@map("categories")
}

model Listing {
  id               String         @id @default(cuid())
  slug             String
  sellerId         String         @map("seller_id") @db.Uuid
  categoryId       String?        @map("category_id")
  vertical         Vertical       @default(MARKETPLACE)
  title            String
  description      String         @default("")
  priceType        PriceType?     @map("price_type")
  /// Preis in Cent. BigInt, damit auch Immobilienpreise abbildbar sind.
  priceCents       BigInt?        @map("price_cents")
  condition        ItemCondition?
  /// Kategorieabhängige Zusatzfelder (validiert gegen Category.attributeSchema)
  attributes       Json           @default("{}")
  status           ListingStatus  @default(DRAFT)
  locationId       Int?           @map("location_id")
  viewCount        Int            @default(0) @map("view_count")
  publishedAt      DateTime?      @map("published_at")
  expiresAt        DateTime?      @map("expires_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")
  /// Zusatzleistungen (Phase 7) – abgeleitet aus aktiven Buchungen, damit Suche und Karten ohne Join auskommen.
  /// Maßgeblich bleibt die Buchung; nach Ablauf wirken die Felder nicht mehr (Abfragen vergleichen mit „jetzt“).
  highlightedUntil DateTime?      @map("highlighted_until")
  topUntil         DateTime?      @map("top_until")
  /// Zeitpunkt des letzten Hochschiebens; die Sortierung „Neueste“ nutzt max(publishedAt, bumpedAt)
  bumpedAt         DateTime?      @map("bumped_at")
  /// Wurde die aktuelle Platzierung bezahlt? Dann wird sie als Werbung gekennzeichnet.
  highlightPaid    Boolean        @default(false) @map("highlight_paid")
  topPaid          Boolean        @default(false) @map("top_paid")
  /// Kennung des Anlegeformulars: erneutes Abschicken liefert dasselbe Inserat statt eines zweiten
  clientRequestId  String?        @map("client_request_id") @db.Uuid

  seller        User                 @relation(fields: [sellerId], references: [id])
  category      Category?            @relation(fields: [categoryId], references: [id])
  location      Location?            @relation(fields: [locationId], references: [id])
  images        ListingImage[]
  favorites     Favorite[]
  conversations Conversation[]
  reports       Report[]
  decisions     ModerationDecision[]
  bookings      Booking[]
  viewDays      ListingViewDay[]

  @@unique([sellerId, clientRequestId])
  @@index([status, publishedAt(sort: Desc)])
  @@index([topUntil])
  @@index([sellerId, status])
  @@index([categoryId, status])
  @@index([locationId])
  @@index([expiresAt])
  @@map("listings")
}

/// Verarbeitungsstand eines Inseratsbilds
enum ImageStatus {
  /// Upload-URL ausgegeben, Datei noch nicht geprüft
  PENDING
  /// geprüft, bereinigt, Varianten erzeugt – darf angezeigt werden
  READY
}

/// Bilder eines Inserats. Rohdateien liegen privat unter `uploadKey`, nur verarbeitete Varianten
/// (ohne EXIF, WebP) unter `storageKey` werden ausgeliefert. Reihenfolge: `sortOrder` 0 = Hauptbild.
model ListingImage {
  id           String      @id @default(cuid())
  listingId    String      @map("listing_id")
  status       ImageStatus @default(PENDING)
  /// Schlüssel der unverarbeiteten Datei, z. B. "uploads/<listingId>/<imageId>"; nach Verarbeitung null
  uploadKey    String?     @map("upload_key")
  /// Präfix der Varianten, z. B. "images/<listingId>/<imageId>" (+ "/large.webp", "/thumb.webp")
  storageKey   String      @map("storage_key")
  /// Vom Browser angekündigter Typ und Größe (nur Plausibilität, maßgeblich ist die Prüfung nach dem Upload)
  declaredType String      @map("declared_type")
  declaredSize Int         @map("declared_size")
  /// Tatsächlich erkannter Typ der Originaldatei
  detectedType String?     @map("detected_type")
  width        Int?
  height       Int?
  /// Gesamtgröße der gespeicherten Varianten in Byte
  storedBytes  Int?        @map("stored_bytes")
  sortOrder    Int         @default(0) @map("sort_order")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  processedAt  DateTime?   @map("processed_at")
  listing      Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, status, sortOrder])
  @@index([status, createdAt])
  @@map("listing_images")
}

// ---------------------------------------------------------------------------
// Merkliste, gespeicherte Suchen, Nachrichten (Phase 5)
// ---------------------------------------------------------------------------

/// Gemerktes Inserat. Der zusammengesetzte Schlüssel verhindert doppelte Einträge.
model Favorite {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([listingId])
  @@map("favorites")
}

/// Gespeicherte Suche: dieselben Parameter wie in der Such-URL (siehe docs/suche.md).
model SavedSearch {
  id             String          @id @default(cuid())
  userId         String          @map("user_id") @db.Uuid
  /// Welche Suche: Inserate (/suche), Deals (/deals) oder Anbieterprofile (/dienstleistungen) – Phase 10
  kind           SavedSearchKind @default(LISTINGS)
  name           String          @db.VarChar(80)
  /// Kanonische Suchparameter (`toSearchParams`), ohne Seite
  params         Json
  /// Sortierter Query-String der Parameter: dieselbe Suche kann nicht doppelt gespeichert werden
  queryKey       String          @map("query_key") @db.VarChar(2000)
  /// Lesbare Filter zur Anzeige im Konto, z. B. „Preis bis € 500“
  labels         String[]        @default([])
  /// E-Mail bei neuen Treffern
  notify         Boolean         @default(false)
  /// Neue Treffer werden ab diesem Zeitpunkt gesucht
  lastCheckedAt  DateTime        @default(now()) @map("last_checked_at")
  lastNotifiedAt DateTime?       @map("last_notified_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, queryKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([notify, lastCheckedAt])
  @@map("saved_searches")
}

enum SavedSearchKind {
  LISTINGS
  DEALS
  SERVICES
}

/// Gemerkte Deals (Phase 10); getrennt von der Merkliste für Inserate
model DealFavorite {
  userId    String   @map("user_id") @db.Uuid
  dealId    String   @map("deal_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@id([userId, dealId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([dealId])
  @@map("deal_favorites")
}

/// Gemerkte Anbieterprofile (Phase 10)
model ServiceFavorite {
  userId    String         @map("user_id") @db.Uuid
  profileId String         @map("profile_id")
  createdAt DateTime       @default(now()) @map("created_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   ServiceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([userId, profileId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([profileId])
  @@map("service_favorites")
}

/// Unterhaltung zwischen Interessent und Verkäufer zu genau einem Inserat.
model Conversation {
  id               String          @id @default(cuid())
  /// Worum es geht: genau eines von Inserat, Anbieterprofil (Phase 10) bzw. Projektauftrag (Phase 10)
  listingId        String?         @map("listing_id")
  serviceProfileId String?         @map("service_profile_id")
  projectId        String?         @map("project_id")
  buyerId          String          @map("buyer_id") @db.Uuid
  sellerId         String          @map("seller_id") @db.Uuid
  lastMessageAt    DateTime        @default(now()) @map("last_message_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  listing          Listing?        @relation(fields: [listingId], references: [id], onDelete: Restrict)
  serviceProfile   ServiceProfile? @relation(fields: [serviceProfileId], references: [id], onDelete: Restrict)
  project          ServiceProject? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  buyer            User            @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller           User            @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages         Message[]
  reports          Report[]

  /// Je Inserat (bzw. Profil) und Interessent genau eine Unterhaltung
  @@unique([listingId, buyerId])
  @@unique([serviceProfileId, buyerId])
  @@unique([projectId, buyerId])
  @@index([buyerId, lastMessageAt(sort: Desc)])
  @@index([sellerId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

/// Private Nachricht. Wird nie in Suchindizes übernommen und nur den beiden Beteiligten ausgeliefert.
model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id") @db.Uuid
  recipientId    String       @map("recipient_id") @db.Uuid
  /// Klartext, max. 2000 Zeichen. Wird nie als HTML ausgegeben.
  body           String       @db.VarChar(2000)
  createdAt      DateTime     @default(now()) @map("created_at")
  readAt         DateTime?    @map("read_at")
  /// Zeitpunkt der E-Mail an den Empfänger (bzw. der Entscheidung, keine zu senden)
  notifiedAt     DateTime?    @map("notified_at")
  /// Vom Gerät erzeugte Kennung: erneutes Abschicken derselben Nachricht legt keine zweite an
  clientId       String?      @map("client_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      User         @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt])
  @@index([recipientId, readAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

/// Blockierte Person kann der blockierenden keine Nachrichten mehr senden (und umgekehrt).
model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("BlockBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockOf", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

enum ReportReason {
  SPAM
  FRAUD
  HARASSMENT
  OTHER
  PROHIBITED_ITEM
  MISLEADING
}

enum ReportStatus {
  OPEN
  /// Wird von einer Moderatorin bzw. einem Moderator bearbeitet
  IN_REVIEW
  /// Bearbeitet, Maßnahme getroffen
  RESOLVED
  /// Bearbeitet, kein Verstoß (bzw. offensichtlich unbegründet)
  DISMISSED
}

/// Gemeldeter Inhalt: ein Inserat oder eine Unterhaltung (die andere Person)
enum ReportTarget {
  LISTING
  CONVERSATION
  /// Deal bzw. Angebot eines Händlers (Phase 10)
  DEAL
  /// Anbieterprofil für Dienstleistungen (Phase 10)
  SERVICE_PROFILE
  /// Projektauftrag (Phase 10)
  PROJECT
}

enum ReportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ---------------------------------------------------------------------------
// Moderation (Phase 6) – Meldungen, Entscheidungen, Einsprüche, Mitteilungen
// ---------------------------------------------------------------------------

/// Meldung (Art. 16 DSA) zu einem Inserat oder aus einer Unterhaltung. Bis Phase 5 hieß die Tabelle user_reports.
/// Meldungen führen nie automatisch zu einer Sperre; jede Maßnahme trifft ein Mensch (moderation_decisions).
model Report {
  id               String              @id @default(cuid())
  targetType       ReportTarget        @default(CONVERSATION) @map("target_type")
  /// Meldende Person; null, wenn ihr Konto gelöscht wurde
  reporterId       String?             @map("reporter_id") @db.Uuid
  /// Betroffene Person (Anbieterin des Inserats bzw. Gesprächspartner)
  reportedId       String?             @map("reported_id") @db.Uuid
  listingId        String?             @map("listing_id")
  conversationId   String?             @map("conversation_id")
  dealId           String?             @map("deal_id")
  serviceProfileId String?             @map("service_profile_id")
  projectId        String?             @map("project_id")
  reason           ReportReason
  details          String?             @db.VarChar(1000)
  status           ReportStatus        @default(OPEN)
  priority         ReportPriority      @default(NORMAL)
  assigneeId       String?             @map("assignee_id") @db.Uuid
  /// Offensichtlich unbegründete Meldung (Art. 23 DSA) – zählt für die Einschränkung der Meldefunktion
  abusive          Boolean             @default(false)
  /// Entscheidung, mit der die Meldung erledigt wurde
  decisionId       String?             @map("decision_id")
  /// Interne Notiz der Moderation zum Abschluss (wird der meldenden Person nicht gezeigt)
  resolutionNote   String?             @map("resolution_note") @db.VarChar(1000)
  handledById      String?             @map("handled_by_id") @db.Uuid
  handledAt        DateTime?           @map("handled_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at")
  reporter         User?               @relation("ReportBy", fields: [reporterId], references: [id], onDelete: SetNull)
  reported         User?               @relation("ReportOf", fields: [reportedId], references: [id], onDelete: SetNull)
  assignee         User?               @relation("ReportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  handledBy        User?               @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)
  listing          Listing?            @relation(fields: [listingId], references: [id], onDelete: SetNull)
  conversation     Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  deal             Deal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  serviceProfile   ServiceProfile?     @relation(fields: [serviceProfileId], references: [id], onDelete: SetNull)
  project          ServiceProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  decision         ModerationDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  events           ReportEvent[]

  @@index([status, createdAt])
  @@index([status, priority, createdAt])
  @@index([reportedId])
  @@index([listingId, status])
  @@index([reporterId, createdAt])
  @@index([conversationId])
  @@index([dealId, status])
  @@index([serviceProfileId, status])
  @@index([projectId, status])
  @@map("reports")
}

enum ReportEventType {
  CREATED
  ASSIGNED
  UNASSIGNED
  PRIORITY_CHANGED
  STATUS_CHANGED
  NOTE
}

/// Bearbeitungsverlauf einer Meldung (wer hat wann was geändert)
model ReportEvent {
  id         String          @id @default(cuid())
  reportId   String          @map("report_id")
  actorId    String?         @map("actor_id") @db.Uuid
  type       ReportEventType
  fromStatus ReportStatus?   @map("from_status")
  toStatus   ReportStatus?   @map("to_status")
  note       String?         @db.VarChar(1000)
  metadata   Json?
  createdAt  DateTime        @default(now()) @map("created_at")
  report     Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor      User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
  @@map("report_events")
}

enum ModerationAction {
  /// Inserat wegen eines Verstoßes deaktiviert (Status REJECTED)
  LISTING_REJECTED
  /// Inserat bis zur Prüfung ausgeblendet (Status PENDING_REVIEW)
  LISTING_HIDDEN
  /// Inserat nach Prüfung wieder freigegeben
  LISTING_RESTORED
  ACCOUNT_SUSPENDED
  ACCOUNT_RESTORED
  /// Deal wegen eines Verstoßes deaktiviert (Status REJECTED), z. B. irreführender Rabatt
  DEAL_REJECTED
  /// Deal bis zur Prüfung ausgeblendet (Status PENDING_REVIEW)
  DEAL_HIDDEN
  /// Deal nach Prüfung freigegeben
  DEAL_RESTORED
  /// Händlerkonto darf keine Deals mehr veröffentlichen (alle Deals ausgeblendet; Konto sonst nutzbar)
  DEALS_BLOCKED
  DEALS_UNBLOCKED
  /// Anbieterprofil wegen eines Verstoßes deaktiviert (Status REJECTED)
  SERVICE_PROFILE_REJECTED
  /// Anbieterprofil bis zur Prüfung ausgeblendet (Status PENDING_REVIEW)
  SERVICE_PROFILE_HIDDEN
  SERVICE_PROFILE_RESTORED
  /// Einzelner Portfolio-Eintrag ausgeblendet (Eintrag in snapshot.portfolioItemId)
  PORTFOLIO_ITEM_HIDDEN
  PORTFOLIO_ITEM_RESTORED
  /// Projektauftrag wegen eines Verstoßes deaktiviert (Status REJECTED)
  PROJECT_REJECTED
  /// Projektauftrag bis zur Prüfung ausgeblendet (Status PENDING_REVIEW)
  PROJECT_HIDDEN
  PROJECT_RESTORED
}

/// Rechtsgrundlage einer Maßnahme (Art. 17 Abs. 3 lit. d/e DSA)
enum DecisionGround {
  /// Verstoß gegen die Nutzungsbedingungen
  TERMS
  /// Mutmaßlich rechtswidriger Inhalt
  ILLEGAL
}

/// Moderationsentscheidung mit Begründung an die betroffene Person (Art. 17 DSA). Wird nie automatisch getroffen.
model ModerationDecision {
  id               String               @id @default(cuid())
  action           ModerationAction
  /// Betroffene Person
  userId           String               @map("user_id") @db.Uuid
  listingId        String?              @map("listing_id")
  dealId           String?              @map("deal_id")
  serviceProfileId String?              @map("service_profile_id")
  projectId        String?              @map("project_id")
  moderatorId      String?              @map("moderator_id") @db.Uuid
  /// Art des Verstoßes (bei Freigaben leer)
  reason           ReportReason?
  ground           DecisionGround?
  /// Begründung, die die betroffene Person sieht
  statement        String               @db.VarChar(2000)
  internalNote     String?              @map("internal_note") @db.VarChar(1000)
  /// Stand des Inserats bei der Entscheidung (Titel, Beschreibung, Preis …) – zur Nachvollziehbarkeit
  snapshot         Json?
  /// Durch diese Entscheidung aufgehobene frühere Entscheidung (z. B. Freigabe nach Einspruch)
  reversesId       String?              @map("reverses_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  user             User                 @relation("DecisionSubject", fields: [userId], references: [id], onDelete: Cascade)
  moderator        User?                @relation("DecisionModerator", fields: [moderatorId], references: [id], onDelete: SetNull)
  listing          Listing?             @relation(fields: [listingId], references: [id], onDelete: SetNull)
  deal             Deal?                @relation(fields: [dealId], references: [id], onDelete: SetNull)
  serviceProfile   ServiceProfile?      @relation(fields: [serviceProfileId], references: [id], onDelete: SetNull)
  project          ServiceProject?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reverses         ModerationDecision?  @relation("DecisionReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy       ModerationDecision[] @relation("DecisionReversal")
  appeal           Appeal?
  reports          Report[]
  notifications    Notification[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([listingId, createdAt(sort: Desc)])
  @@index([dealId, createdAt(sort: Desc)])
  @@index([serviceProfileId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("moderation_decisions")
}

enum AppealStatus {
  OPEN
  /// Entscheidung bleibt bestehen
  UPHELD
  /// Entscheidung wurde aufgehoben
  REVERSED
}

/// Einspruch gegen eine Moderationsentscheidung (internes Beschwerdemanagement, Art. 20 DSA). Je Entscheidung einer.
model Appeal {
  id         String             @id @default(cuid())
  decisionId String             @unique @map("decision_id")
  userId     String             @map("user_id") @db.Uuid
  body       String             @db.VarChar(2000)
  status     AppealStatus       @default(OPEN)
  reviewerId String?            @map("reviewer_id") @db.Uuid
  /// Antwort an die Person, die Einspruch erhoben hat
  response   String?            @db.VarChar(2000)
  createdAt  DateTime           @default(now()) @map("created_at")
  decidedAt  DateTime?          @map("decided_at")
  decision   ModerationDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  user       User               @relation("AppealBy", fields: [userId], references: [id], onDelete: Cascade)
  reviewer   User?              @relation("AppealReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@map("appeals")
}

enum NotificationType {
  LISTING_REJECTED
  LISTING_HIDDEN
  LISTING_RESTORED
  ACCOUNT_SUSPENDED
  ACCOUNT_RESTORED
  APPEAL_DECIDED
  REPORT_HANDLED
  DEAL_REJECTED
  DEAL_HIDDEN
  DEAL_RESTORED
  DEALS_BLOCKED
  DEALS_UNBLOCKED
  SERVICE_PROFILE_REJECTED
  SERVICE_PROFILE_HIDDEN
  SERVICE_PROFILE_RESTORED
  PORTFOLIO_ITEM_HIDDEN
  PORTFOLIO_ITEM_RESTORED
  QUALIFICATION_REVIEWED
  PROJECT_REJECTED
  PROJECT_HIDDEN
  PROJECT_RESTORED
}

/// Mitteilung im Konto (zusätzlich per E-Mail). Für Entscheidungen der Moderation, Einsprüche und Meldungen.
model Notification {
  id         String              @id @default(cuid())
  userId     String              @map("user_id") @db.Uuid
  type       NotificationType
  title      String              @db.VarChar(200)
  body       String              @db.VarChar(2000)
  /// Interner Pfad, z. B. /konto/entscheidungen/<id>
  link       String?             @db.VarChar(300)
  decisionId String?             @map("decision_id")
  readAt     DateTime?           @map("read_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision   ModerationDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

enum DeletionStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Auftrag zur Kontolöschung (DSGVO Art. 17). Die Schritte sind einzeln wiederholbar; der Stand bleibt nachvollziehbar.
model AccountDeletion {
  id             String         @id @default(cuid())
  userId         String         @unique @map("user_id") @db.Uuid
  status         DeletionStatus @default(PENDING)
  /// Erledigte Schritte (siehe account-deletion.service.ts)
  completedSteps String[]       @default([]) @map("completed_steps")
  attempts       Int            @default(0)
  /// Letzter Fehler (ohne personenbezogene Daten)
  lastError      String?        @map("last_error") @db.VarChar(500)
  requestedAt    DateTime       @default(now()) @map("requested_at")
  completedAt    DateTime?      @map("completed_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@map("account_deletions")
}

// ---------------------------------------------------------------------------
// Monetarisierung (Phase 7) – Leistungen, Preise, Buchungen, Zahlungen, Statistiken
// Zum Start ist alles kostenlos (BillingMode FREE). Siehe docs/monetarisierung.md.
// ---------------------------------------------------------------------------

/// Was eine aktivierte Buchung bewirkt
enum ProductKind {
  /// Inserat veröffentlichen bzw. verlängern
  LISTING
  /// Optische Hervorhebung auf Inseratskarten
  HIGHLIGHT
  /// Platz im Bereich „Top-Anzeigen“ passender Suchergebnisse
  TOP_AD
  /// Inserat in der Sortierung „Neueste“ wieder nach oben bringen (einmalig)
  BUMP
}

/// Globaler Betriebsmodus. PAID erfordert eine ausdrückliche Umstellung durch einen Admin und Stripe.
enum BillingMode {
  FREE
  PAID
}

enum BookingStatus {
  /// Wartet auf eine bestätigte Zahlung (nur im kostenpflichtigen Betrieb)
  PENDING_PAYMENT
  /// Leistung wirkt bis `endsAt`
  ACTIVE
  /// Einmalige Leistung erbracht (Hochschieben)
  COMPLETED
  EXPIRED
  /// Abgebrochen (z. B. Zahlung nicht abgeschlossen) – ohne Wirkung
  CANCELLED
  /// Zahlung erstattet – Wirkung beendet
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Buchbare Leistung. Preise in Cent; ob tatsächlich verrechnet wird, entscheiden BillingMode und paidEnabled.
model Product {
  id                String      @id @default(cuid())
  /// Eindeutige Produktkennung, z. B. „listing“, „highlight“, „top“, „bump“
  code              String      @unique @db.VarChar(40)
  kind              ProductKind
  name              String      @db.VarChar(80)
  description       String      @db.VarChar(500)
  /// Preis im kostenpflichtigen Betrieb (Cent). Zum Start 0.
  priceCents        Int         @default(0) @map("price_cents")
  /// Geplanter späterer Preis – nur zur Information, wird nie automatisch wirksam
  plannedPriceCents Int?        @map("planned_price_cents")
  currency          String      @default("EUR") @db.Char(3)
  /// Laufzeit in Tagen (Inserat, Hervorhebung, Top-Anzeige); beim Hochschieben leer
  durationDays      Int?        @map("duration_days")
  forPrivate        Boolean     @default(true) @map("for_private")
  forBusiness       Boolean     @default(true) @map("for_business")
  /// Leistung wird angeboten
  isActive          Boolean     @default(true) @map("is_active")
  /// Darf im kostenpflichtigen Betrieb verrechnet werden (zusätzlich zu BillingMode PAID)
  paidEnabled       Boolean     @default(false) @map("paid_enabled")
  /// Optionaler Aktionszeitraum: in dieser Zeit immer kostenlos. Das Ende schaltet nichts automatisch frei.
  promoStartsAt     DateTime?   @map("promo_starts_at")
  promoEndsAt       DateTime?   @map("promo_ends_at")
  /// Gleichzeitig aktive Buchungen je Konto
  maxActivePerUser  Int?        @map("max_active_per_user")
  /// Gleichzeitig aktive Buchungen insgesamt (z. B. Plätze für Top-Anzeigen)
  maxActiveTotal    Int?        @map("max_active_total")
  /// Buchungen je Konto im Zeitraum `periodDays`
  maxPerPeriod      Int?        @map("max_per_period")
  periodDays        Int         @default(30) @map("period_days")
  /// Mindestabstand zwischen zwei Buchungen für dasselbe Inserat (Hochschieben)
  cooldownHours     Int?        @map("cooldown_hours")
  sortOrder         Int         @default(0) @map("sort_order")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  bookings          Booking[]

  @@map("products")
}

/// Plattformweite Einstellungen (genau eine Zeile, id = 1)
model PlatformSettings {
  id                    Int         @id @default(1)
  billingMode           BillingMode @default(FREE) @map("billing_mode")
  billingModeChangedAt  DateTime?   @map("billing_mode_changed_at")
  billingModeChangedBy  String?     @map("billing_mode_changed_by") @db.Uuid
  /// Einführungsaktion auf der Website
  introEnabled          Boolean     @default(true) @map("intro_enabled")
  introVisible          Boolean     @default(true) @map("intro_visible")
  introTitle            String      @default("Jetzt kostenlos inserieren") @map("intro_title") @db.VarChar(80)
  introDescription      String      @default("Während unserer Einführungsphase kannst du deine Inserate kostenlos veröffentlichen.") @map("intro_description") @db.VarChar(400)
  introStartsAt         DateTime?   @map("intro_starts_at")
  introEndsAt           DateTime?   @map("intro_ends_at")
  /// Geplanten Standardpreis des Inserats (Produkt „listing“) in der Aktion anzeigen
  introShowPlannedPrice Boolean     @default(false) @map("intro_show_planned_price")
  /// Schutz vor automatisierter Nutzung: Buchungen je Konto und Stunde (alle Leistungen)
  maxBookingsPerHour    Int         @default(20) @map("max_bookings_per_hour")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// Buchung einer Leistung. Preis und Produktangaben werden beim Buchen festgehalten und nie nachträglich geändert.
model Booking {
  id             String        @id @default(cuid())
  /// null, wenn das Konto gelöscht wurde (bezahlte Buchungen bleiben für die Buchhaltung erhalten)
  userId         String?       @map("user_id") @db.Uuid
  listingId      String?       @map("listing_id")
  productId      String        @map("product_id")
  kind           ProductKind
  status         BookingStatus
  /// Preis zum Buchungszeitpunkt in Cent (0 = kostenlos)
  priceCents     Int           @map("price_cents")
  currency       String        @default("EUR") @db.Char(3)
  /// Betriebsmodus beim Buchen
  billingMode    BillingMode   @map("billing_mode")
  /// Produkt zum Buchungszeitpunkt: Code, Name, Laufzeit, Standardpreis, geplanter Preis, Aktion
  snapshot       Json
  startsAt       DateTime?     @map("starts_at")
  endsAt         DateTime?     @map("ends_at")
  /// Vom Formular erzeugter Schlüssel: dieselbe Anfrage legt nie zwei Buchungen an
  idempotencyKey String?       @map("idempotency_key") @db.VarChar(64)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  listing        Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  product        Product       @relation(fields: [productId], references: [id])
  payment        Payment?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([listingId, kind, status])
  @@index([status, endsAt])
  @@index([productId, status])
  @@map("bookings")
}

/// Zahlung zu einer Buchung (Stripe Checkout). Wird nur über geprüfte Webhooks bzw. die Stripe-API bestätigt.
model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique @map("booking_id")
  userId            String?       @map("user_id") @db.Uuid
  provider          String        @default("stripe") @db.VarChar(20)
  status            PaymentStatus @default(PENDING)
  amountCents       Int           @map("amount_cents")
  refundedCents     Int           @default(0) @map("refunded_cents")
  currency          String        @default("EUR") @db.Char(3)
  /// Stripe-Live-Modus – bleibt gesperrt (STRIPE_LIVE_ENABLED)
  livemode          Boolean       @default(false)
  checkoutSessionId String?       @unique @map("checkout_session_id")
  paymentIntentId   String?       @unique @map("payment_intent_id")
  failureReason     String?       @map("failure_reason") @db.VarChar(300)
  /// Vorbereitet für die Beleg- und Rechnungshistorie
  receiptUrl        String?       @map("receipt_url") @db.VarChar(500)
  invoiceNumber     String?       @unique @map("invoice_number") @db.VarChar(40)
  paidAt            DateTime?     @map("paid_at")
  refundedAt        DateTime?     @map("refunded_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("payments")
}

/// Verarbeitete Stripe-Ereignisse (Idempotenz: jedes Ereignis wirkt genau einmal)
model StripeEvent {
  id          String   @id @db.VarChar(255)
  type        String   @db.VarChar(100)
  livemode    Boolean
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("stripe_events")
}

/// Aufrufe je Inserat und Tag (ohne eigene Aufrufe, Bots und wiederholtes Neuladen). Keine IPs gespeichert.
model ListingViewDay {
  listingId String   @map("listing_id")
  day       DateTime @db.Date
  views     Int      @default(0)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([listingId, day])
  @@map("listing_view_days")
}

// ---------------------------------------------------------------------------
// Deals & Angebote (Phase 10) – Angebote gewerblicher Händler, getrennt von Kleinanzeigen.
// Preis-, Link- und Ablaufregeln: docs/deals.md
// ---------------------------------------------------------------------------

enum DealStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  /// Ausgeblendet bis zur Prüfung (auffälliger Rabatt oder Entscheidung der Moderation)
  PENDING_REVIEW
  REJECTED
  DELETED
}

enum DealChannel {
  ONLINE
  LOCAL
  BOTH
}

/// Grundlage des Vergleichspreises. Ohne Grundlage gibt es keinen Rabatt.
enum ReferencePriceType {
  /// Niedrigster Preis des Händlers in den 30 Tagen vor der Ermäßigung (Angabe des Händlers)
  LOWEST_30_DAYS
  /// Unverbindliche Preisempfehlung des Herstellers (Angabe des Händlers mit Quelle)
  RRP
  /// Vom Team geprüfter Marktvergleich – vorbereitet, derzeit nicht vergeben
  MARKET_CHECK
}

enum DealAvailability {
  UNKNOWN
  IN_STOCK
  LIMITED
  SOLD_OUT
}

enum DealImageRights {
  OWN
  MANUFACTURER
  LICENSED
}

enum DealSource {
  MANUAL
  CSV
  FEED
  /// Zentral über ein Affiliate-Netzwerk (Awin): gehört keinem MarktAT-Händlerkonto, sondern einem freigegebenen Partnerprogramm
  AFFILIATE
}

enum DealLinkStatus {
  UNCHECKED
  OK
  BROKEN
}

/// Kategorien der Deals (Seed aus DEAL_CATEGORIES in @marktat/shared)
model DealCategory {
  id                  String             @id @default(cuid())
  slug                String             @unique
  name                String             @unique
  icon                String?
  sortOrder           Int                @default(0) @map("sort_order")
  isActive            Boolean            @default(true) @map("is_active")
  /// Verwandte Kategorie der Kleinanzeigen (Pfad), z. B. für „Ähnliche Kleinanzeigen“
  relatedCategoryPath String?            @map("related_category_path")
  deals               Deal[]
  affiliatePrograms   AffiliateProgram[]

  @@map("deal_categories")
}

/// Angebot eines gewerblichen Händlers. Bewusst kein Inserat: Preis, Vergleichspreis, Link, Laufzeit und Prüfung
/// folgen eigenen Regeln.
model Deal {
  id                        String              @id @default(cuid())
  slug                      String
  /// Händlerkonto bei MarktAT; leer nur bei Affiliate-Deals (Herkunft AFFILIATE, siehe CHECK deals_owner_check)
  merchantId                String?             @map("merchant_id") @db.Uuid
  /// Partnerprogramm im Affiliate-Netzwerk (nur Herkunft AFFILIATE)
  affiliateProgramId        String?             @map("affiliate_program_id")
  /// Produktfeed des Netzwerks, aus dem der Deal zuletzt kam
  affiliateFeedId           String?             @map("affiliate_feed_id")
  categoryId                String              @map("category_id")
  title                     String              @db.VarChar(120)
  description               String              @default("") @db.VarChar(3000)
  brand                     String?             @db.VarChar(60)
  /// GTIN/EAN (vorbereitet für einen späteren Preisvergleich)
  gtin                      String?             @db.VarChar(14)
  /// Stabile Angebots-/Artikelnummer des Händlers: Importe aktualisieren darüber statt Doppelte anzulegen
  externalId                String?             @map("external_id") @db.VarChar(100)
  channel                   DealChannel
  url                       String?             @db.VarChar(1000)
  isAffiliateLink           Boolean             @default(false) @map("is_affiliate_link")
  /// Aktueller Angebotspreis in Cent (inkl. USt.)
  priceCents                Int                 @map("price_cents")
  currency                  String              @default("EUR") @db.Char(3)
  unitPriceText             String?             @map("unit_price_text") @db.VarChar(40)
  shippingNote              String?             @map("shipping_note") @db.VarChar(120)
  /// Vergleichspreis des Händlers samt Grundlage und Quelle
  referencePriceCents       Int?                @map("reference_price_cents")
  referencePriceType        ReferencePriceType? @map("reference_price_type")
  referencePriceSource      String?             @map("reference_price_source") @db.VarChar(200)
  referencePriceEvidenceUrl String?             @map("reference_price_evidence_url") @db.VarChar(500)
  /// Zeitpunkt, zu dem der Händler die Richtigkeit des Vergleichspreises bestätigt hat
  referenceConfirmedAt      DateTime?           @map("reference_confirmed_at")
  /// Abgeleitet (nie aus der Eingabe): ganze Prozent, abgerundet, nur mit Grundlage
  discountPercent           Int?                @map("discount_percent")
  availability              DealAvailability    @default(UNKNOWN)
  startsAt                  DateTime            @map("starts_at")
  endsAt                    DateTime            @map("ends_at")
  status                    DealStatus          @default(DRAFT)
  publishedAt               DateTime?           @map("published_at")
  /// „Zuletzt geprüft“: Bestätigung durch Händler, Import oder Feed. Ohne Bestätigung kein „aktuell“.
  lastVerifiedAt            DateTime?           @map("last_verified_at")
  /// Warum der Deal vor der Veröffentlichung geprüft wird (z. B. sehr hoher Rabatt)
  reviewReason              String?             @map("review_reason") @db.VarChar(200)
  /// Präfix der Bildvarianten, z. B. "deals/<id>/<uuid>" (+ "/large.webp", "/thumb.webp")
  imageKey                  String?             @map("image_key")
  imageWidth                Int?                @map("image_width")
  imageHeight               Int?                @map("image_height")
  imageRights               DealImageRights?    @map("image_rights")
  imageCredit               String?             @map("image_credit") @db.VarChar(120)
  /// Nur Affiliate-Deals: Produktbild des Händlers laut Feed – wird unverändert über die API weitergereicht, nie kopiert
  externalImageUrl          String?             @map("external_image_url") @db.VarChar(1000)
  source                    DealSource          @default(MANUAL)
  /// Prüfsumme der importierten Werte (unveränderte Zeilen werden übersprungen)
  contentHash               String?             @map("content_hash") @db.VarChar(64)
  linkStatus                DealLinkStatus      @default(UNCHECKED) @map("link_status")
  linkCheckedAt             DateTime?           @map("link_checked_at")
  linkFailures              Int                 @default(0) @map("link_failures")
  viewCount                 Int                 @default(0) @map("view_count")
  clickCount                Int                 @default(0) @map("click_count")
  clientRequestId           String?             @map("client_request_id") @db.Uuid
  /// Freigegebener Produktfeed, aus dem der Deal stammt (Herkunft FEED)
  feedId                    String?             @map("feed_id")
  /// Letzter Import (CSV oder Feed), der den Deal angelegt oder geändert hat
  lastImportId              String?             @map("last_import_id")
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")
  deletedAt                 DateTime?           @map("deleted_at")

  merchant         User?                @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  affiliateProgram AffiliateProgram?    @relation(fields: [affiliateProgramId], references: [id], onDelete: Restrict)
  affiliateFeed    AffiliateFeed?       @relation(fields: [affiliateFeedId], references: [id], onDelete: SetNull)
  category         DealCategory         @relation(fields: [categoryId], references: [id])
  stores           DealStore[]
  priceRecords     DealPriceRecord[]
  reports          Report[]
  decisions        ModerationDecision[]
  favorites        DealFavorite[]
  feed             DealFeed?            @relation(fields: [feedId], references: [id])

  @@unique([merchantId, externalId])
  @@unique([merchantId, clientRequestId])
  /// Ein Produkt je Partnerprogramm (stabile Artikelnummer aus dem Feed) – keine Doppelten
  @@unique([affiliateProgramId, externalId])
  @@index([affiliateFeedId])
  @@index([status, endsAt])
  @@index([status, publishedAt(sort: Desc)])
  @@index([merchantId, status])
  @@index([categoryId, status])
  @@index([lastVerifiedAt])
  @@index([linkCheckedAt])
  @@index([feedId])
  @@map("deals")
}

/// Filiale bzw. Geschäft eines Händlers. Der Standort für die Umkreissuche kommt aus dem Ort (PLZ).
model DealerStore {
  id           String      @id @default(cuid())
  merchantId   String      @map("merchant_id") @db.Uuid
  name         String      @db.VarChar(120)
  street       String      @db.VarChar(200)
  locationId   Int         @map("location_id")
  openingHours String?     @map("opening_hours") @db.VarChar(300)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")
  merchant     User        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  location     Location    @relation(fields: [locationId], references: [id])
  deals        DealStore[]

  @@index([merchantId])
  @@index([locationId])
  @@map("dealer_stores")
}

/// In welchen Filialen ein lokales Angebot gilt
model DealStore {
  dealId  String      @map("deal_id")
  storeId String      @map("store_id")
  deal    Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  store   DealerStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([dealId, storeId])
  @@index([storeId])
  @@map("deal_stores")
}

/// Eigene Aufzeichnung der Preise (bei jeder Änderung) – Grundlage für „niedrigster erfasster Preis“ und einen
/// späteren Preisvergleich. Nie geschätzt oder nachträglich erzeugt.
model DealPriceRecord {
  id                  BigInt     @id @default(autoincrement())
  dealId              String     @map("deal_id")
  priceCents          Int        @map("price_cents")
  referencePriceCents Int?       @map("reference_price_cents")
  source              DealSource
  recordedAt          DateTime   @default(now()) @map("recorded_at")
  deal                Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, recordedAt(sort: Desc)])
  @@map("deal_price_records")
}

// ---------------------------------------------------------------------------
// Sicherheit
// ---------------------------------------------------------------------------

/// Protokoll sicherheitsrelevanter Ereignisse. Enthält keine Passwörter, Tokens oder Volltext-IPs.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  /// Gekürzte IP (IPv4 /24, IPv6 /48) – datensparsam nach DSGVO
  ipPrefix   String?  @map("ip_prefix")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Phase 8: Technische Fehler (unerwartete 5xx, endgültig fehlgeschlagene Hintergrundaufträge), zusammengefasst je Ursache.
/// Datensparsam: keine Anfragedaten, keine IDs aus Pfaden, keine Personen – nur Quelle, Routenmuster, Fehlerart und gekürzte Meldung.
model ErrorEvent {
  id          BigInt   @id @default(autoincrement())
  /// sha256(Quelle | Route | Fehlerart | normalisierte Meldung) – gleiche Ursache = eine Zeile
  fingerprint String   @unique
  /// http | job | web
  source      String
  /// z. B. "POST /v1/listings/:id/publish" oder Auftragsname
  route       String
  errorName   String   @map("error_name")
  message     String
  /// Erste Zeilen des Stacktraces (nur Dateipfade/Funktionen)
  stack       String?
  count       Int      @default(1)
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  @@index([lastSeenAt])
  @@map("error_events")
}

enum DealImportStatus {
  PREVIEW
  COMMITTED
  FAILED
  CANCELLED
  EXPIRED
}

enum DealFeedFormat {
  CSV
  JSON
}

enum DealFeedStatus {
  /// Wartet auf Freigabe durch das Team – wird nicht abgerufen
  PENDING
  APPROVED
  REJECTED
  PAUSED
  /// Nach mehreren Fehlschlägen in Folge angehalten
  FAILING
}

/// Massenimport (CSV-Datei oder Abruf eines Feeds): Vorschau, Ergebnis je Zeile, Historie
model DealImport {
  id                 String           @id @default(cuid())
  merchantId         String           @map("merchant_id") @db.Uuid
  feedId             String?          @map("feed_id")
  source             DealSource
  format             DealFeedFormat   @default(CSV)
  fileName           String?          @map("file_name") @db.VarChar(200)
  status             DealImportStatus @default(PREVIEW)
  /// Rohdaten nur bis zur Übernahme bzw. bis zum Ablauf der Vorschau
  rawText            String?          @map("raw_text")
  headers            Json             @default("[]")
  mapping            Json             @default("{}")
  /// Ergebnis je Zeile (DealImportRowResult[])
  rows               Json             @default("[]")
  counts             Json             @default("{}")
  hasReferencePrices Boolean          @default(false) @map("has_reference_prices")
  publish            Boolean?
  error              String?          @db.VarChar(500)
  createdAt          DateTime         @default(now()) @map("created_at")
  committedAt        DateTime?        @map("committed_at")
  expiresAt          DateTime?        @map("expires_at")

  merchant User      @relation(fields: [merchantId], references: [id])
  feed     DealFeed? @relation(fields: [feedId], references: [id])

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@index([feedId, createdAt(sort: Desc)])
  @@map("deal_imports")
}

/// Produktfeed eines Händlers (eigener oder lizenzierter Feed); wird erst nach Freigabe durch das Team abgerufen
model DealFeed {
  id                       String           @id @default(cuid())
  merchantId               String           @map("merchant_id") @db.Uuid
  name                     String           @db.VarChar(80)
  url                      String           @db.VarChar(500)
  format                   DealFeedFormat
  intervalHours            Int              @map("interval_hours")
  /// Herkunft und Nutzungsbedingungen laut Händler
  licenseNote              String           @map("license_note") @db.VarChar(500)
  licenseConfirmedAt       DateTime         @map("license_confirmed_at")
  referencePricesConfirmed Boolean          @default(false) @map("reference_prices_confirmed")
  imageRights              DealImageRights? @map("image_rights")
  mapping                  Json             @default("{}")
  status                   DealFeedStatus   @default(PENDING)
  reviewNote               String?          @map("review_note") @db.VarChar(500)
  reviewedById             String?          @map("reviewed_by_id") @db.Uuid
  approvedAt               DateTime?        @map("approved_at")
  etag                     String?          @db.VarChar(200)
  lastModified             String?          @map("last_modified") @db.VarChar(100)
  lastFetchedAt            DateTime?        @map("last_fetched_at")
  nextFetchAt              DateTime?        @map("next_fetch_at")
  lastError                String?          @map("last_error") @db.VarChar(500)
  consecutiveFailures      Int              @default(0) @map("consecutive_failures")
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
  deletedAt                DateTime?        @map("deleted_at")

  merchant User         @relation(fields: [merchantId], references: [id])
  deals    Deal[]
  imports  DealImport[]

  @@index([status, nextFetchAt])
  @@index([merchantId])
  @@map("deal_feeds")
}

// ---------------------------------------------------------------------------
// Dienstleistungen (Phase 10): Anbieterprofile als Erweiterung des Kontos, Portfolio, Qualifikationen
// ---------------------------------------------------------------------------

enum ServiceProfileStatus {
  DRAFT
  ACTIVE
  PAUSED
  PENDING_REVIEW
  REJECTED
  /// Von der Inhaber:in entfernt; die Zeile bleibt für bestehende Unterhaltungen und Entscheidungen
  DELETED
}

enum ServicePriceType {
  HOURLY
  FIXED
  ON_REQUEST
}

enum ServiceAvailability {
  AVAILABLE
  LIMITED
  UNAVAILABLE
}

enum PortfolioImageRights {
  OWN
  CLIENT_PERMISSION
  LICENSED
}

enum QualificationStatus {
  CLAIMED
  VERIFIED
  REJECTED
}

/// Kategorien der Dienstleistungen (Seed aus packages/shared/src/services/categories.ts)
model ServiceCategory {
  id                  String  @id @default(cuid())
  slug                String  @unique
  name                String
  groupSlug           String  @map("group_slug")
  groupName           String  @map("group_name")
  /// Für die Tätigkeit kann eine Gewerbeberechtigung bzw. ein Befähigungsnachweis nötig sein
  regulated           Boolean @default(false)
  /// Verwandte Kategorie der Kleinanzeigen (Marktplatz › Dienstleistungen bzw. Jobs › Freelance)
  relatedCategoryPath String? @map("related_category_path")
  sortOrder           Int     @default(0) @map("sort_order")
  isActive            Boolean @default(true) @map("is_active")

  profiles  ServiceProfileCategory[]
  portfolio ServicePortfolioItem[]
  projects  ServiceProject[]

  @@index([groupSlug, sortOrder])
  @@map("service_categories")
}

/// Anbieterprofil: Erweiterung eines bestehenden Kontos (höchstens eines je Konto, keine eigene Registrierung)
model ServiceProfile {
  id               String                @id @default(cuid())
  userId           String                @unique @map("user_id") @db.Uuid
  status           ServiceProfileStatus  @default(DRAFT)
  headline         String                @db.VarChar(120)
  summary          String                @db.VarChar(300)
  description      String                @db.VarChar(5000)
  skills           String[]              @default([])
  locationId       Int?                  @map("location_id")
  serviceRadiusKm  Int?                  @map("service_radius_km")
  austriaWide      Boolean               @default(false) @map("austria_wide")
  remote           Boolean               @default(false)
  priceType        ServicePriceType      @default(ON_REQUEST) @map("price_type")
  /// Stundensatz bzw. Pauschale „ab“ in Cent (leer bei „auf Anfrage“)
  priceCents       Int?                  @map("price_cents")
  experienceYears  Int?                  @map("experience_years")
  website          String?               @db.VarChar(300)
  availability     ServiceAvailability   @default(AVAILABLE)
  availabilityNote String?               @map("availability_note") @db.VarChar(160)
  imageKey         String?               @map("image_key")
  imageRights      PortfolioImageRights? @map("image_rights")
  imageCredit      String?               @map("image_credit") @db.VarChar(120)
  /// Grund, solange das Team das Profil prüft
  reviewReason     String?               @map("review_reason") @db.VarChar(300)
  /// Bestätigung der Angaben beim ersten Veröffentlichen
  confirmedAt      DateTime?             @map("confirmed_at")
  publishedAt      DateTime?             @map("published_at")
  viewCount        Int                   @default(0) @map("view_count")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location       Location?                @relation(fields: [locationId], references: [id])
  categories     ServiceProfileCategory[]
  portfolio      ServicePortfolioItem[]
  qualifications ServiceQualification[]
  conversations  Conversation[]
  reports        Report[]
  decisions      ModerationDecision[]
  favorites      ServiceFavorite[]

  @@index([status, updatedAt(sort: Desc)])
  @@index([locationId])
  @@map("service_profiles")
}

model ServiceProfileCategory {
  profileId  String @map("profile_id")
  categoryId String @map("category_id")

  profile  ServiceProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id])

  @@id([profileId, categoryId])
  @@index([categoryId])
  @@map("service_profile_categories")
}

/// Arbeitsprobe im Portfolio (Bild nur mit Angabe der Rechte)
model ServicePortfolioItem {
  id          String                @id @default(cuid())
  profileId   String                @map("profile_id")
  title       String                @db.VarChar(120)
  description String?               @db.VarChar(1000)
  categoryId  String?               @map("category_id")
  url         String?               @db.VarChar(500)
  imageKey    String?               @map("image_key")
  imageRights PortfolioImageRights? @map("image_rights")
  imageCredit String?               @map("image_credit") @db.VarChar(120)
  sortOrder   Int                   @default(0) @map("sort_order")
  /// Vom Team ausgeblendet (Begründung in moderation_decisions)
  hiddenAt    DateTime?             @map("hidden_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  profile  ServiceProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category ServiceCategory? @relation(fields: [categoryId], references: [id])

  @@index([profileId, sortOrder])
  @@map("service_portfolio_items")
}

/// Qualifikation laut Anbieter:in; „geprüft“ nur nach Prüfung durch das Team
model ServiceQualification {
  id           String              @id @default(cuid())
  profileId    String              @map("profile_id")
  title        String              @db.VarChar(120)
  issuer       String?             @db.VarChar(120)
  /// z. B. GISA-Zahl, Register- oder Zeugnisnummer (öffentlich erst nach der Prüfung)
  reference    String?             @db.VarChar(120)
  status       QualificationStatus @default(CLAIMED)
  reviewedById String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?           @map("reviewed_at")
  reviewNote   String?             @map("review_note") @db.VarChar(500)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  profile    ServiceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reviewedBy User?          @relation("QualificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([status])
  @@map("service_qualifications")
}

// ---------------------------------------------------------------------------
// Projektaufträge (Phase 10): Jemand sucht für ein konkretes Vorhaben eine selbstständige Dienstleistung.
// Kein Jobangebot und keine Ausschreibung: keine Gebote, keine öffentlichen Angebote, Kontakt nur über Nachrichten.
// ---------------------------------------------------------------------------

enum ServiceProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  /// Von der Auftraggeber:in beendet (z. B. jemand gefunden)
  CLOSED
  PENDING_REVIEW
  REJECTED
  /// Von der Auftraggeber:in entfernt; die Zeile bleibt für bestehende Unterhaltungen und Entscheidungen
  DELETED
}

enum ProjectBudgetType {
  /// Pauschalbetrag für das Vorhaben
  FIXED
  /// Stundensatz
  HOURLY
  /// Noch offen bzw. nach Absprache
  OPEN
}

model ServiceProject {
  id           String               @id @default(cuid())
  userId       String               @map("user_id") @db.Uuid
  status       ServiceProjectStatus @default(DRAFT)
  title        String               @db.VarChar(120)
  description  String               @db.VarChar(5000)
  categoryId   String               @map("category_id")
  /// Ort der Arbeit (leer bei reiner Remote-Arbeit)
  locationId   Int?                 @map("location_id")
  remote       Boolean              @default(false)
  budgetType   ProjectBudgetType    @default(OPEN) @map("budget_type")
  /// Budget in Cent (Pauschale bzw. Stundensatz bis), leer bei „offen“
  budgetCents  Int?                 @map("budget_cents")
  /// Zeitrahmen in Worten, z. B. „bis Ende März“
  timeframe    String?              @db.VarChar(160)
  /// Sichtbar bis (ab Veröffentlichung 30 Tage, verlängerbar)
  expiresAt    DateTime?            @map("expires_at")
  publishedAt  DateTime?            @map("published_at")
  confirmedAt  DateTime?            @map("confirmed_at")
  closedAt     DateTime?            @map("closed_at")
  reviewReason String?              @map("review_reason") @db.VarChar(300)
  viewCount    Int                  @default(0) @map("view_count")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      ServiceCategory      @relation(fields: [categoryId], references: [id])
  location      Location?            @relation(fields: [locationId], references: [id])
  conversations Conversation[]
  reports       Report[]
  decisions     ModerationDecision[]

  @@index([status, expiresAt])
  @@index([userId, status])
  @@index([categoryId])
  @@index([locationId])
  @@map("service_projects")
}

// ---------------------------------------------------------------------------
// Zentrale Affiliate-Deals (Awin-Publisher, weitere Netzwerke später). Getrennt von Händlerkonten:
// Angebote gehören einem Partnerprogramm, nie einem MarktAT-Händler. Regeln: docs/affiliate.md
// ---------------------------------------------------------------------------

enum AffiliateNetwork {
  AWIN
}

/// Unsere Freigabe eines Programms (erst APPROVED erscheint öffentlich)
enum AffiliateProgramStatus {
  PENDING
  APPROVED
  PAUSED
  REJECTED
}

/// Teilnahme am Programm laut Netzwerk (nur JOINED darf beworben werden)
enum AffiliateMembership {
  JOINED
  NOT_JOINED
  PENDING
  SUSPENDED
  UNKNOWN
}

enum AffiliateFeedStatus {
  /// Neu in der Feedliste, noch nicht freigegeben
  PENDING
  ACTIVE
  PAUSED
  /// Mehrere Fehlschläge in Folge – wird nicht mehr abgerufen, bis das Team ihn fortsetzt
  FAILING
  /// Nicht mehr in der Feedliste des Netzwerks
  REMOVED
}

enum AffiliateSyncKind {
  FEED_LIST
  FEED
  PROMOTIONS
}

enum AffiliateSyncStatus {
  RUNNING
  SUCCESS
  /// Teilweise übernommen (z. B. Zeilen übersprungen, Höchstzahl erreicht)
  PARTIAL
  FAILED
}

enum AffiliatePromotionType {
  PROMOTION
  VOUCHER
}

/// Partnerprogramm (Advertiser) in einem Affiliate-Netzwerk
model AffiliateProgram {
  id                   String                 @id @default(cuid())
  network              AffiliateNetwork
  /// ID des Advertisers im Netzwerk
  externalId           String                 @map("external_id") @db.VarChar(40)
  name                 String                 @db.VarChar(120)
  region               String?                @db.VarChar(10)
  membership           AffiliateMembership    @default(UNKNOWN)
  membershipCheckedAt  DateTime?              @map("membership_checked_at")
  status               AffiliateProgramStatus @default(PENDING)
  /// Dokumentation der Freigabe: Programmbedingungen geprüft, Besonderheiten (Pflicht bei Freigabe)
  approvalNote         String?                @map("approval_note") @db.VarChar(1000)
  reviewedById         String?                @map("reviewed_by_id") @db.Uuid
  approvedAt           DateTime?              @map("approved_at")
  /// Produktbilder des Händlers dürfen gezeigt werden (laut Programmbedingungen)
  allowImages          Boolean                @default(false) @map("allow_images")
  /// UVP aus dem Feed darf als Vergleichspreis gezeigt werden (Quelle wird angegeben)
  allowReferencePrices Boolean                @default(false) @map("allow_reference_prices")
  /// Gutscheincodes dürfen veröffentlicht werden
  allowVouchers        Boolean                @default(false) @map("allow_vouchers")
  defaultCategoryId    String?                @map("default_category_id")
  lastSyncAt           DateTime?              @map("last_sync_at")
  lastError            String?                @map("last_error") @db.VarChar(500)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  defaultCategory DealCategory?        @relation(fields: [defaultCategoryId], references: [id])
  feeds           AffiliateFeed[]
  deals           Deal[]
  promotions      AffiliatePromotion[]
  syncRuns        AffiliateSyncRun[]

  @@unique([network, externalId])
  @@index([status])
  @@map("affiliate_programs")
}

/// Produktfeed eines Programms. Die Download-Adresse enthält den API-Schlüssel und wird deshalb nie gespeichert.
model AffiliateFeed {
  id                  String              @id @default(cuid())
  programId           String              @map("program_id")
  externalId          String              @map("external_id") @db.VarChar(40)
  name                String              @db.VarChar(200)
  language            String?             @db.VarChar(10)
  vertical            String?             @db.VarChar(60)
  status              AffiliateFeedStatus @default(PENDING)
  approvalNote        String?             @map("approval_note") @db.VarChar(1000)
  reviewedById        String?             @map("reviewed_by_id") @db.Uuid
  approvedAt          DateTime?           @map("approved_at")
  /// „Last Imported“ laut Feedliste des Netzwerks
  networkUpdatedAt    DateTime?           @map("network_updated_at")
  /// Stand, der zuletzt vollständig übernommen wurde (gleich = kein erneuter Download)
  processedUpdatedAt  DateTime?           @map("processed_updated_at")
  listedAt            DateTime?           @map("listed_at")
  lastFetchedAt       DateTime?           @map("last_fetched_at")
  nextFetchAt         DateTime?           @map("next_fetch_at")
  lastError           String?             @map("last_error") @db.VarChar(500)
  consecutiveFailures Int                 @default(0) @map("consecutive_failures")
  productCount        Int                 @default(0) @map("product_count")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  program  AffiliateProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)
  deals    Deal[]
  syncRuns AffiliateSyncRun[]

  @@unique([programId, externalId])
  @@index([status, nextFetchAt])
  @@map("affiliate_feeds")
}

/// Protokoll jedes Abrufs (Feedliste, Feed, Aktionen) mit Zählern und Fehlern – Grundlage der Admin-Übersicht
model AffiliateSyncRun {
  id            String              @id @default(cuid())
  network       AffiliateNetwork
  kind          AffiliateSyncKind
  status        AffiliateSyncStatus @default(RUNNING)
  programId     String?             @map("program_id")
  feedId        String?             @map("feed_id")
  /// Zähler: angelegt, aktualisiert, unverändert, beendet, übersprungen je Grund
  stats         Json                @default("{}")
  error         String?             @db.VarChar(1000)
  /// Manuell gestartet von (leer = Zeitplan)
  triggeredById String?             @map("triggered_by_id") @db.Uuid
  startedAt     DateTime            @default(now()) @map("started_at")
  finishedAt    DateTime?           @map("finished_at")

  program AffiliateProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  feed    AffiliateFeed?    @relation(fields: [feedId], references: [id], onDelete: SetNull)

  @@index([startedAt(sort: Desc)])
  @@index([kind, status, startedAt(sort: Desc)])
  @@index([feedId, startedAt(sort: Desc)])
  @@map("affiliate_sync_runs")
}

/// Aktion oder Gutschein eines Programms (Awin Publisher Offers API)
model AffiliatePromotion {
  id          String                 @id @default(cuid())
  programId   String                 @map("program_id")
  externalId  String                 @map("external_id") @db.VarChar(40)
  type        AffiliatePromotionType
  title       String                 @db.VarChar(200)
  description String                 @default("") @db.VarChar(2000)
  terms       String?                @db.VarChar(2000)
  /// Nur gespeichert, wenn das Programm Gutscheincodes erlaubt
  voucherCode String?                @map("voucher_code") @db.VarChar(80)
  /// Tracking-Link des Netzwerks
  url         String                 @db.VarChar(1000)
  startsAt    DateTime?              @map("starts_at")
  endsAt      DateTime?              @map("ends_at")
  /// Zuletzt in der Antwort des Netzwerks enthalten; fehlt sie, wird die Aktion ausgeblendet
  lastSeenAt  DateTime               @map("last_seen_at")
  hiddenAt    DateTime?              @map("hidden_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  program AffiliateProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, externalId])
  @@index([hiddenAt, endsAt])
  @@map("affiliate_promotions")
}
