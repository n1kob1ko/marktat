// MarktAT – Datenbankschema (PostgreSQL 16 + PostGIS)
// Überblick und geplante Erweiterungen: docs/datenmodell.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Die vier Hauptbereiche der Plattform
enum Vertical {
  MARKETPLACE
  VEHICLES
  REAL_ESTATE
  JOBS
}

enum AccountType {
  PRIVATE
  BUSINESS
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum PriceType {
  FIXED
  NEGOTIABLE
  FREE
  ON_REQUEST
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  EXPIRED
  REJECTED
  DELETED
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  ACCEPTABLE
  DEFECTIVE
}

// ---------------------------------------------------------------------------
// Benutzer
// ---------------------------------------------------------------------------

/// Profil zu einem Supabase-Auth-Benutzer. `id` entspricht `auth.users.id` (JWT-Claim `sub`).
/// Passwörter und Sitzungen verwaltet ausschließlich Supabase Auth.
model User {
  id                    String      @id @db.Uuid
  email                 String      @unique
  displayName           String      @map("display_name")
  accountType           AccountType @default(PRIVATE) @map("account_type")
  role                  UserRole    @default(USER)
  status                UserStatus  @default(ACTIVE)
  avatarUrl             String?     @map("avatar_url")
  bio                   String?
  phone                 String?
  /// Pflichtangaben gewerblicher Anbieter (Kennzeichnung nach DSA / ECG)
  companyName           String?     @map("company_name")
  companyRegisterNumber String?     @map("company_register_number")
  vatId                 String?     @map("vat_id")
  companyAddress        String?     @map("company_address")
  termsAcceptedAt       DateTime?   @map("terms_accepted_at")
  termsVersion          String?     @map("terms_version")
  lastSeenAt            DateTime?   @map("last_seen_at")
  /// E-Mail bei neuen Nachrichten (höchstens eine je Unterhaltung, bis wieder gelesen wurde)
  notifyMessagesByEmail Boolean     @default(true) @map("notify_messages_by_email")
  /// E-Mail bei neuen Treffern gespeicherter Suchen (nur Suchen mit aktivierter Benachrichtigung)
  notifySearchesByEmail Boolean     @default(true) @map("notify_searches_by_email")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  deletedAt             DateTime?   @map("deleted_at")

  listings            Listing[]
  auditLogs           AuditLog[]
  favorites           Favorite[]
  savedSearches       SavedSearch[]
  buyerConversations  Conversation[] @relation("ConversationBuyer")
  sellerConversations Conversation[] @relation("ConversationSeller")
  sentMessages        Message[]      @relation("MessageSender")
  receivedMessages    Message[]      @relation("MessageRecipient")
  blocks              UserBlock[]    @relation("BlockBy")
  blockedBy           UserBlock[]    @relation("BlockOf")
  reportsMade         UserReport[]   @relation("ReportBy")
  reportsReceived     UserReport[]   @relation("ReportOf")

  @@index([status])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Geografie: Bundesland -> Bezirk -> Ort (PLZ)
// ---------------------------------------------------------------------------

model State {
  /// 1 = Burgenland … 9 = Wien (Statistik-Austria-Kennziffer)
  id        Int        @id
  /// ISO 3166-2, z. B. "AT-9"
  code      String     @unique
  slug      String     @unique
  name      String
  districts District[]

  @@map("states")
}

/// Politischer Bezirk bzw. Statutarstadt; in Wien die 23 Gemeindebezirke.
model District {
  /// Bezirkskennziffer von Statistik Austria, z. B. 101 = Eisenstadt (Stadt), 901 = Wien 1., Innere Stadt
  id        Int        @id
  stateId   Int        @map("state_id")
  slug      String
  name      String
  state     State      @relation(fields: [stateId], references: [id])
  locations Location[]

  @@unique([stateId, slug])
  @@map("districts")
}

/// Ort mit Postleitzahl. Eine PLZ kann mehrere Orte umfassen und umgekehrt.
model Location {
  id           Int                                    @id @default(autoincrement())
  postalCode   String                                 @map("postal_code") @db.VarChar(4)
  place        String
  /// Gemeinde laut Statistik Austria (z. B. „Innsbruck“ für den Ortsteil „Wilten“), in Wien „Wien“
  municipality String?
  slug         String
  districtId   Int                                    @map("district_id")
  latitude     Float
  longitude    Float
  /// Wird aus latitude/longitude befüllt (siehe Seed); für Umkreissuche mit ST_DWithin
  geom         Unsupported("geography(Point, 4326)")?
  district     District                               @relation(fields: [districtId], references: [id])
  listings     Listing[]

  @@unique([postalCode, place])
  @@index([postalCode])
  @@index([districtId])
  @@index([geom], type: Gist)
  @@index([place(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Kategorien und Inserate
// ---------------------------------------------------------------------------

model Category {
  id              String     @id @default(cuid())
  parentId        String?    @map("parent_id")
  vertical        Vertical
  slug            String
  /// Eindeutiger Pfad für SEO-URLs, z. B. "marktplatz/elektronik/handys-smartphones"
  path            String     @unique
  name            String
  icon            String?
  sortOrder       Int        @default(0) @map("sort_order")
  isActive        Boolean    @default(true) @map("is_active")
  /// Definition kategorieabhängiger Felder (Typ, Label, Pflicht, Optionen) – ab Phase 2/5
  attributeSchema Json?      @map("attribute_schema")
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryTree")
  listings        Listing[]

  @@index([parentId])
  @@index([vertical, isActive])
  @@map("categories")
}

model Listing {
  id          String         @id @default(cuid())
  slug        String
  sellerId    String         @map("seller_id") @db.Uuid
  categoryId  String?        @map("category_id")
  vertical    Vertical       @default(MARKETPLACE)
  title       String
  description String         @default("")
  priceType   PriceType?     @map("price_type")
  /// Preis in Cent. BigInt, damit auch Immobilienpreise abbildbar sind.
  priceCents  BigInt?        @map("price_cents")
  condition   ItemCondition?
  /// Kategorieabhängige Zusatzfelder (validiert gegen Category.attributeSchema)
  attributes  Json           @default("{}")
  status      ListingStatus  @default(DRAFT)
  locationId  Int?           @map("location_id")
  viewCount   Int            @default(0) @map("view_count")
  publishedAt DateTime?      @map("published_at")
  expiresAt   DateTime?      @map("expires_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  seller        User           @relation(fields: [sellerId], references: [id])
  category      Category?      @relation(fields: [categoryId], references: [id])
  location      Location?      @relation(fields: [locationId], references: [id])
  images        ListingImage[]
  favorites     Favorite[]
  conversations Conversation[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([sellerId, status])
  @@index([categoryId, status])
  @@index([locationId])
  @@index([expiresAt])
  @@map("listings")
}

/// Verarbeitungsstand eines Inseratsbilds
enum ImageStatus {
  /// Upload-URL ausgegeben, Datei noch nicht geprüft
  PENDING
  /// geprüft, bereinigt, Varianten erzeugt – darf angezeigt werden
  READY
}

/// Bilder eines Inserats. Rohdateien liegen privat unter `uploadKey`, nur verarbeitete Varianten
/// (ohne EXIF, WebP) unter `storageKey` werden ausgeliefert. Reihenfolge: `sortOrder` 0 = Hauptbild.
model ListingImage {
  id           String      @id @default(cuid())
  listingId    String      @map("listing_id")
  status       ImageStatus @default(PENDING)
  /// Schlüssel der unverarbeiteten Datei, z. B. "uploads/<listingId>/<imageId>"; nach Verarbeitung null
  uploadKey    String?     @map("upload_key")
  /// Präfix der Varianten, z. B. "images/<listingId>/<imageId>" (+ "/large.webp", "/thumb.webp")
  storageKey   String      @map("storage_key")
  /// Vom Browser angekündigter Typ und Größe (nur Plausibilität, maßgeblich ist die Prüfung nach dem Upload)
  declaredType String      @map("declared_type")
  declaredSize Int         @map("declared_size")
  /// Tatsächlich erkannter Typ der Originaldatei
  detectedType String?     @map("detected_type")
  width        Int?
  height       Int?
  /// Gesamtgröße der gespeicherten Varianten in Byte
  storedBytes  Int?        @map("stored_bytes")
  sortOrder    Int         @default(0) @map("sort_order")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  processedAt  DateTime?   @map("processed_at")
  listing      Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, status, sortOrder])
  @@index([status, createdAt])
  @@map("listing_images")
}

// ---------------------------------------------------------------------------
// Merkliste, gespeicherte Suchen, Nachrichten (Phase 5)
// ---------------------------------------------------------------------------

/// Gemerktes Inserat. Der zusammengesetzte Schlüssel verhindert doppelte Einträge.
model Favorite {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([listingId])
  @@map("favorites")
}

/// Gespeicherte Suche: dieselben Parameter wie in der Such-URL (siehe docs/suche.md).
model SavedSearch {
  id             String    @id @default(cuid())
  userId         String    @map("user_id") @db.Uuid
  name           String    @db.VarChar(80)
  /// Kanonische Suchparameter (`toSearchParams`), ohne Seite
  params         Json
  /// Sortierter Query-String der Parameter: dieselbe Suche kann nicht doppelt gespeichert werden
  queryKey       String    @map("query_key") @db.VarChar(2000)
  /// Lesbare Filter zur Anzeige im Konto, z. B. „Preis bis € 500“
  labels         String[]  @default([])
  /// E-Mail bei neuen Treffern
  notify         Boolean   @default(false)
  /// Neue Treffer werden ab diesem Zeitpunkt gesucht
  lastCheckedAt  DateTime  @default(now()) @map("last_checked_at")
  lastNotifiedAt DateTime? @map("last_notified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, queryKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([notify, lastCheckedAt])
  @@map("saved_searches")
}

/// Unterhaltung zwischen Interessent und Verkäufer zu genau einem Inserat.
model Conversation {
  id            String       @id @default(cuid())
  listingId     String       @map("listing_id")
  buyerId       String       @map("buyer_id") @db.Uuid
  sellerId      String       @map("seller_id") @db.Uuid
  lastMessageAt DateTime     @default(now()) @map("last_message_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  listing       Listing      @relation(fields: [listingId], references: [id])
  buyer         User         @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller        User         @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages      Message[]
  reports       UserReport[]

  /// Je Inserat und Interessent genau eine Unterhaltung
  @@unique([listingId, buyerId])
  @@index([buyerId, lastMessageAt(sort: Desc)])
  @@index([sellerId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

/// Private Nachricht. Wird nie in Suchindizes übernommen und nur den beiden Beteiligten ausgeliefert.
model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id") @db.Uuid
  recipientId    String       @map("recipient_id") @db.Uuid
  /// Klartext, max. 2000 Zeichen. Wird nie als HTML ausgegeben.
  body           String       @db.VarChar(2000)
  createdAt      DateTime     @default(now()) @map("created_at")
  readAt         DateTime?    @map("read_at")
  /// Zeitpunkt der E-Mail an den Empfänger (bzw. der Entscheidung, keine zu senden)
  notifiedAt     DateTime?    @map("notified_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      User         @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([recipientId, readAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

/// Blockierte Person kann der blockierenden keine Nachrichten mehr senden (und umgekehrt).
model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("BlockBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockOf", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

enum ReportReason {
  SPAM
  FRAUD
  HARASSMENT
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Meldung einer Person (z. B. aus einer Unterhaltung). Bearbeitung durch die Moderation folgt später.
model UserReport {
  id             String        @id @default(cuid())
  reporterId     String        @map("reporter_id") @db.Uuid
  reportedId     String        @map("reported_id") @db.Uuid
  conversationId String?       @map("conversation_id")
  reason         ReportReason
  details        String?       @db.VarChar(1000)
  status         ReportStatus  @default(OPEN)
  createdAt      DateTime      @default(now()) @map("created_at")
  reporter       User          @relation("ReportBy", fields: [reporterId], references: [id], onDelete: Cascade)
  reported       User          @relation("ReportOf", fields: [reportedId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedId])
  @@map("user_reports")
}

// ---------------------------------------------------------------------------
// Sicherheit
// ---------------------------------------------------------------------------

/// Protokoll sicherheitsrelevanter Ereignisse. Enthält keine Passwörter, Tokens oder Volltext-IPs.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  /// Gekürzte IP (IPv4 /24, IPv6 /48) – datensparsam nach DSGVO
  ipPrefix   String?  @map("ip_prefix")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
