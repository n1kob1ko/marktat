{
  "name": "marktat",
  "private": true,
  "description": "MarktAT – Kleinanzeigenplattform für Österreich (Monorepo)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "db:migrate": "pnpm --filter @marktat/api db:migrate",
    "db:seed": "pnpm --filter @marktat/shared build && pnpm --filter @marktat/api db:generate && pnpm --filter @marktat/api db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.10",
    "typescript": "6.0.3"
  }
}
