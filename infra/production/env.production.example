# ---------------------------------------------------------------------------
# MarktAT – Umgebungsvariablen für den Online-Betrieb (Server: /opt/marktat/.env, Rechte 600)
#
#   1. Vorlage kopieren:          cp env.production.example .env && chmod 600 .env
#   2. Geheimnisse erzeugen:      node generate-secrets.mjs .env   (füllt die leeren Geheimnis-Zeilen mit Zufallswerten)
#   3. Restliche Werte eintragen: Domains, E-Mail-Versand, R2 – siehe docs/deployment.md
#   4. Prüfen:                    ./deploy.sh check
#
# Die Datei liegt NUR auf dem Server. Nie committen, nie in Chats oder Tickets kopieren.
# Werte aus der lokalen Entwicklungs-.env (Dev-Tokens, marktat_dev_pw, marktat-dev-Bucket …) hier nie verwenden.
# ---------------------------------------------------------------------------

# --- Adressen ------------------------------------------------------------------
# Web-App und API (inkl. Supabase Auth unter /auth/v1). Beide brauchen einen A-Record auf die Server-IP.
# Vorerst KEIN AAAA-Record (IPv6), siehe docs/deployment.md, Abschnitt DNS.
WEB_DOMAIN=
API_DOMAIN=
# Kontaktadresse für Let's Encrypt (Ablaufwarnungen der Zertifikate)
ACME_EMAIL=
# Nur für Proben ohne echte Domain (lokale Zertifikate): local_certs
CADDY_GLOBAL_EXTRA=

# --- Images (setzt deploy.sh; nur ändern, wenn die Images woanders liegen) -------------
# API_IMAGE=ghcr.io/n1kob1ko/marktat-api
# WEB_IMAGE=ghcr.io/n1kob1ko/marktat-web

# --- Geheimnisse (generate-secrets.mjs) ---------------------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MEILI_MASTER_KEY=
# HS256-Secret von Supabase Auth; ANON- und SERVICE_ROLE-Key sind damit signierte Tokens
SUPABASE_JWT_SECRET=
# Öffentlich (steckt im Web-Image), aber je Umgebung eigen
SUPABASE_ANON_KEY=
# GEHEIM – nur die API (Kontolöschung, 2FA zurücksetzen)
SUPABASE_SERVICE_ROLE_KEY=
# Signierte Bild-URLs für Entwürfe
APP_SIGNING_SECRET=
# Passwort für die verschlüsselten Datenbanksicherungen (gpg). Zusätzlich offline aufbewahren,
# sonst sind die Sicherungen wertlos.
BACKUP_PASSPHRASE=

# --- E-Mail-Versand (Transaktionsdienst, z. B. Scaleway TEM oder Brevo) ---------------
# Absenderdomain muss beim Anbieter verifiziert sein (SPF, DKIM, DMARC – docs/deployment.md)
SMTP_HOST=
SMTP_PORT=587
# false = STARTTLS auf Port 587 (Standard); true = TLS ab Verbindungsbeginn auf Port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Absender der App-E-Mails (Nachrichten, Suchaufträge, Moderation)
MAIL_FROM="MarktAT <noreply@example.at>"
# Nur die Adresse – Absender der Bestätigungs- und Passwort-E-Mails von Supabase Auth
MAIL_FROM_ADDRESS=noreply@example.at
# Höchstzahl der Auth-E-Mails (Bestätigung, Passwort) je Stunde für die ganze Plattform – Schutz vor Missbrauch
# und vor Überschreiten des Gratiskontingents beim Versanddienst
AUTH_RATE_LIMIT_EMAIL_SENT=60
MESSAGE_EMAIL_DELAY_SECONDS=120
SAVED_SEARCH_ALERT_MINUTES=30

# --- Bilder: eigener Produktions-Bucket bei Cloudflare R2 (privat, nicht marktat-dev) ------
# Eigenes API-Token nur für diesen Bucket („Object Read & Write“)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=marktat-prod
R2_JURISDICTION=default
R2_ENDPOINT=

# --- Suche / Hintergrundaufgaben --------------------------------------------------
MEILI_INDEX=listings
QUEUE_PREFIX=marktat
JOBS_WORKER=true

# --- Deals (Phase 10) ----------------------------------------------------------------
# Angebotslinks regelmäßig prüfen und freigegebene Händler-Feeds abrufen (nur öffentliche https-Adressen)
DEAL_LINK_CHECK=true
DEAL_FEED_SYNC=true

# --- Partnerangebote über Awin (nur Publisher-Konto, KEIN Advertiser-Tarif) -------------
# Bleibt false, bis Publisher-Konto, Partnerschaften und Schlüssel vorliegen (docs/affiliate.md).
# Schlüssel nur hier auf dem Server eintragen, nie ins Repository oder in GitHub-Secrets.
AWIN_ENABLED=false
# Publisher-ID (nur Ziffern, im Awin-Konto oben links)
AWIN_PUBLISHER_ID=
# API-Token: ui.awin.com/awin-api → „Show my API token“
AWIN_API_TOKEN=
# Feed-Schlüssel: Toolbox → Create-a-Feed, Teil nach „apikey/“ in der Download-Adresse
AWIN_FEED_API_KEY=
AWIN_REGION=AT
AWIN_MAX_PRODUCTS_PER_FEED=5000

# --- Sicherheit -------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
# Zwei-Faktor-Anmeldung für Moderation und Administration – im Online-Betrieb immer an
STAFF_MFA_REQUIRED=true
STEP_UP_MAX_AGE_MINUTES=10
# Optional: Zugangsschutz (HTTP-Basic-Auth) für die Web-App, z. B. für eine geschlossene Probephase.
# Format benutzer:passwort. Leer = öffentlich erreichbar (Beta). Gilt nur für die Web-Adresse.
BETA_BASIC_AUTH=

# --- Kostenloser Betrieb ------------------------------------------------------------
# Bleibt leer bzw. false: keine echten Zahlungen. Änderungen nur nach ausdrücklicher Freigabe von Niko.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_ENABLED=false
AI_ENABLED=false
OPENAI_API_KEY=

# --- Sicherungen (backup.sh, täglich per cron) ---------------------------------------
# Aufbewahrung in Tagen auf dem Server (rechtliche Löschfristen beachten, docs/rechtliches.md)
BACKUP_RETENTION_DAYS=14
# Optional: zusätzlich verschlüsselt in einen EIGENEN R2-Bucket (nicht den Bilder-Bucket) mit eigenem Token
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
